# Telegram Bot token from @BotFather
BOT_TOKEN=8968505835:AAHbcvUV6HF4a7WF2SSfZ7gHwtBBhVOzxrk

# Maximum file size to upload to Telegram, in MB.
# Telegram bots can upload up to 50 MB by default (2000 MB with a local Bot API server).
MAX_FILESIZE_MB=50

# Directory where downloads are temporarily stored.
DOWNLOAD_DIR=downloads

# Optional: comma-separated list of Telegram user IDs allowed to use the bot.
# Leave empty to allow everyone.
ALLOWED_USER_IDS=

# Optional: path to a Netscape-format cookies.txt to download from YouTube on a
# server (YouTube blocks datacenter IPs with "confirm you're not a bot").
# Defaults to ./cookies.txt if that file exists.
COOKIES_FILE=

# ── Large files (>50 MB) via a local Bot API server ──────────────────────────
# To send files up to 2000 MB, run the bundled local Bot API server:
#   docker compose --profile bigfiles up -d --build
# Get api_id / api_hash from https://my.telegram.org, fill them in below,
# point the bot at the local server, and raise MAX_FILESIZE_MB (e.g. 2000).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Set to http://telegram-bot-api:8081 to use the local server (leave empty for cloud).
BOT_API_BASE=
